# Only needed if running `streamlit run streamlit_app.py` locally, outside Snowflake.
# Copy to .streamlit/secrets.toml (never commit the real file) and fill in your values.
[snowflake]
account = "REPLACE_ACCOUNT_IDENTIFIER"   # e.g. abcd-xy12345
user = "REPLACE_USERNAME"
password = "REPLACE_PASSWORD"            # prefer key-pair auth for anything beyond local testing
role = "SYSADMIN"
warehouse = "WALMART_WH"
database = "WALMART_E2E"
schema = "CORE"
