# Copy to .env (never commit the real file) and fill in your values.

# --- AWS ---
AWS_ACCESS_KEY_ID=REPLACE_ME
AWS_SECRET_ACCESS_KEY=REPLACE_ME
AWS_REGION=us-east-1
S3_BUCKET=walmart-e2e-jerry-2026

# --- Snowflake ---
SNOWFLAKE_ACCOUNT=REPLACE_ME          # e.g. abcd-xy12345
SNOWFLAKE_USER=REPLACE_ME
SNOWFLAKE_PASSWORD=REPLACE_ME
SNOWFLAKE_ROLE=SYSADMIN
SNOWFLAKE_WAREHOUSE=WALMART_WH
SNOWFLAKE_DATABASE=WALMART_E2E

# credentials  -> stage stores your AWS key directly (quick start)
# integration  -> stage uses a Snowflake storage integration + IAM role (no keys stored)
STAGE_AUTH_MODE=credentials

# Only used when STAGE_AUTH_MODE=integration
SNOWFLAKE_INTEGRATION_ROLE_ARN=REPLACE_ME
