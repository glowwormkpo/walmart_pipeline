{
  "Version": "2012-10-17",
  "Statement": [
    {
      "Sid": "SnowflakeS3ReadAccess",
      "Effect": "Allow",
      "Action": [
        "s3:GetObject",
        "s3:GetObjectVersion"
      ],
      "Resource": "arn:aws:s3:::REPLACE_BUCKET_NAME/raw/*"
    },
    {
      "Sid": "SnowflakeS3ListAccess",
      "Effect": "Allow",
      "Action": "s3:ListBucket",
      "Resource": "arn:aws:s3:::REPLACE_BUCKET_NAME",
      "Condition": {
        "StringLike": {
          "s3:prefix": ["raw/*"]
        }
      }
    }
  ]
}
